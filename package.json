{
  "name": "aseprite-asset-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Human-friendly pixel-art asset studio connected to aseprite-asset-mcp.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gateway": "tsx server/index.ts",
    "gateway:dev": "tsx watch server/index.ts"
  },
  "dependencies": {
    "@jdsalasc/pixel-ui": "github:jdsalasca/pixel-art-ui#0571f9f",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "sass": "^1.102.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
